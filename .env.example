# Copy this file to .env and add your keys.
# Load before running OpenCode:  export $(grep -v '^#' .env | xargs)   (or use direnv)

# Stitch (Google) MCP – get key from https://stitch.withgoogle.com → profile → Stitch Settings → API Keys → Create Key
STITCH_API_KEY=

# Netlify MCP (optional) – if you prefer PAT over `netlify login`, create a token at Netlify → User settings → OAuth → New access token,
# then add to .opencode/opencode.jsonc under mcp.netlify.environment: "NETLIFY_PERSONAL_ACCESS_TOKEN": "{env:NETLIFY_PERSONAL_ACCESS_TOKEN}"
# NETLIFY_PERSONAL_ACCESS_TOKEN=

# Build API Netlify deploy (optional) – set these to get live_url and claim_url on build completion without using Netlify MCP in the agent.
# NETLIFY_PERSONAL_ACCESS_TOKEN=   (same as above)
# NETLIFY_TEAM_SLUG=              (required for deploy: team/account slug, e.g. from Netlify dashboard URL)
# NETLIFY_OAUTH_CLIENT_ID=        (for claim link; create in Netlify OAuth apps)
# NETLIFY_OAUTH_CLIENT_SECRET=    (for claim link)
# NETLIFY_CLAIM_UTM_SOURCE=opencode

# Build API preview URL (optional) – base URL for preview_url in webhook/GET (default: http://localhost:4096)
# PREVIEW_BASE_URL=http://localhost:4096
